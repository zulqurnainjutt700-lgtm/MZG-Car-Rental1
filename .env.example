PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
SECURE_AUTH_COOKIES=false
# Public deployment: use HTTPS origin and SECURE_AUTH_COOKIES=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Vercel: set BACKEND_ORIGIN to your persistent Node backend HTTPS origin.
# Set a matching random BACKEND_PROXY_SECRET on Vercel and the backend.
BACKEND_ORIGIN=
BACKEND_PROXY_SECRET=
# Backend hosting only (leave unset for local development):
# BIND_HOST=0.0.0.0
# AUTH_DIRECTORY=/var/data/mzg
# HTTPS backend: required 32-byte base64 encryption key for administrator MFA.
# Generate privately with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ADMIN_ENCRYPTION_KEY=
# Optional persistent-backend backup scheduler, in hours (1–168):
BACKUP_INTERVAL_HOURS=0

# Optional hosted PostgreSQL backend; keep this connection string secret.
DATABASE_URL=

# Optional Resend alternative; when both are set it takes precedence over SMTP.
RESEND_API_KEY=
EMAIL_FROM=
# Private random bearer secret (at least 32 characters) for /api/jobs/email.
# Set the same value in Vercel Production; never put it in browser code.
CRON_SECRET=
